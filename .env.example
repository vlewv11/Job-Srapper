# Where posts come from: preview | telegram | auto (default)
#   preview  = t.me/s/ web pages. No credentials at all. Public channels only.
#   telegram = MTProto via Telethon. Reaches groups, needs the three TG_* values.
#   auto     = preview for everything, MTProto only for channels it cannot see.
SCRAPE_SOURCE=auto

# Optional. Only needed for channels with no public web preview (groups), and
# only when SCRAPE_SOURCE is auto or telegram. Get them at https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_SESSION=

SCRAPE_INTERVAL_MINUTES=10
RETENTION_DAYS=30

# Seconds between preview requests (default 1.0). Be polite.
PREVIEW_DELAY_SECONDS=1.0
